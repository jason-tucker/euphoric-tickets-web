# --- Database -------------------------------------------------------------
# In production the docker-compose service overrides this to talk to the
# `db` container directly. Leave the placeholder here so local dev (outside
# Docker) won't crash before you point it somewhere.
DATABASE_URL=postgresql://tickets_web:CHANGE_ME@localhost:5432/tickets_web

# --- Auth.js --------------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
AUTH_SECRET=

# In production: https://tickets.euphoric.fm
# In local dev:  http://localhost:3000
AUTH_URL=http://localhost:3000

# Trust the X-Forwarded-* headers Caddy sends. Required when the app is
# behind a reverse proxy (production), no-op otherwise.
AUTH_TRUST_HOST=true

# --- Discord OAuth --------------------------------------------------------
# Same Discord application as the bot is fine, OR a new one — what matters
# is that the OAuth redirect URL is registered:
#   https://tickets.euphoric.fm/api/auth/callback/discord
#   http://localhost:3000/api/auth/callback/discord  (for dev)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Postgres (docker compose) --------------------------------------------
POSTGRES_PASSWORD=

# --- Image tag (set by CI; override locally for dev) ----------------------
WEB_IMAGE=ghcr.io/jason-tucker/euphoric-tickets-web:latest

# --- Web <-> bot bridge + Integration API ---------------------------------
# REQUIRED (v0.12.2+). Shared secret for every internal web<->bot call
# (x-internal-token): notify, DM, bot control, TicketTool and the Integration
# API bridge. At least 32 characters; the web refuses to boot without it.
# There is no DISCORD_BOT_TOKEN fallback. Same value in the bot's .env.
# Generate: openssl rand -hex 32
INTERNAL_TOKEN=
# The bot's internal HTTP server, e.g. http://euphoric-tickets:8787
# BOT_INTERNAL_URL=
# Public site URL used in links (webUrl, notifications).
# PUBLIC_BASE_URL=https://tickets.euphoric.fm
# 32 random bytes (openssl rand -base64 32). Encrypts integration webhook
# signing secrets at rest. Env only — never commit it or put it in a dump.
# INTEGRATION_ENC_KEY=
# Set to "off" to disable the outbound integration webhook dispatcher.
# INTEGRATION_DISPATCHER=
# Host headers /api/v1/* accepts (comma-separated). Anything else gets 404.
# Default: tickets-web:3000,tickets-web (the internal docker alias). Add a
# published port only for local testing, e.g.
#   INTERNAL_API_HOSTS=tickets-web:3000,tickets-web,127.0.0.1:16095
# INTERNAL_API_HOSTS=
# Honour cf-connecting-ip / x-forwarded-for for the failed-auth brake ONLY
# when a proxy you control sits in front of /api/v1 and overwrites them.
# Default off: all failing requests share one brake bucket.
# INTEGRATION_TRUST_PROXY_HEADERS=
